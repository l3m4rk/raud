{
  "layer": "top",
  "position": "top",

  "modules-left": [
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "network",
    "pulseaudio",
    "cpu",
    "memory"
  ],

  "clock": {
    "format": "{:%H:%M}"
  },

  "network": {
    "format-wifi": "{essid}",
    "format-ethernet": "ethernet",
    "format-disconnected": "offline"
  },

  "pulseaudio": {
    "format": "{volume}%"
  },

  "cpu": {
    "format": "CPU {usage}%"
  },

  "memory": {
    "format": "RAM {}%"
  }
}